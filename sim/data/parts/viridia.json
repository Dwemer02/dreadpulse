        "on_fire": [
          { "op": "repair", "amount": 1 }
        ]
      },
      "augment": {
        "add_keywords": ["repair"],
        "triggers": [
          { "on": "part_fired", "where": { "is_host": true },
            "do": [ { "op": "repair", "amount": 1 } ] }
        ]
      }
    },
    {
